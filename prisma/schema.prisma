generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  EDITOR
}

enum GameStatus {
  ACTIVE
  BETA
  COMING_SOON
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BuildStyle {
  PVE
  PVP
  HYBRID
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaSource {
  UPLOAD
  VK_EMBED
}

// ---------- Core ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  news   News[]
  guides Guide[]
  builds Build[]
}

model Game {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  version         String?
  status          GameStatus @default(COMING_SOON)
  image           String?
  hasCalculator   Boolean    @default(false)
  hasMap          Boolean    @default(false)
  hasPlayerStats  Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  categories Category[]
  news       News[]
  guides     Guide[]
  builds     Build[]
}

model Category {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  news   News[]
  guides Guide[]
  builds Build[]

  @@unique([gameId, slug])
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  news   NewsTag[]
  guides GuideTag[]
  builds BuildTag[]
}

model Media {
  id        String      @id @default(cuid())
  url       String
  type      MediaType
  source    MediaSource @default(UPLOAD)
  alt       String?
  width     Int?
  height    Int?
  createdAt DateTime    @default(now())

  newsAsCover   News[]
  guidesAsCover Guide[]
  buildsAsCover Build[]
}

// ---------- Content ----------

model News {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String
  body        Json
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  gameId     String
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  coverId    String?
  cover      Media?    @relation(fields: [coverId], references: [id])
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])

  tags NewsTag[]

  seoTitle       String?
  seoDescription String?
}

model Guide {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String
  body        Json
  difficulty  Difficulty    @default(BEGINNER)
  version     String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  gameId     String
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  coverId    String?
  cover      Media?    @relation(fields: [coverId], references: [id])
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])

  tags GuideTag[]

  seoTitle       String?
  seoDescription String?
}

model Build {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  body        Json
  weapon      String
  style       BuildStyle
  difficulty  Difficulty    @default(BEGINNER)
  role        String
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  gameId     String
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  coverId    String?
  cover      Media?    @relation(fields: [coverId], references: [id])
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])

  tags BuildTag[]

  seoTitle       String?
  seoDescription String?
}

// ---------- Join tables (explicit, чтобы можно было расширять) ----------

model NewsTag {
  newsId String
  tagId  String
  news   News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
}

model GuideTag {
  guideId String
  tagId   String
  guide   Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([guideId, tagId])
}

model BuildTag {
  buildId String
  tagId   String
  build   Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([buildId, tagId])
}
